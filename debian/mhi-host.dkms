PACKAGE_NAME="mhi-host"
PACKAGE_VERSION="1.0"

MAKE[0]="make -C $kernel_source_dir M=$dkms_tree/$module/$module_version/source"
CLEAN="rm -f mhi.ko mhi_pci.ko mhi_uci.ko mhi_net.ko && make -C $kernel_source_dir M=$dkms_tree/$module/$module_version/source clean"

BUILT_MODULE_NAME[0]="mhi"
BUILT_MODULE_LOCATION[0]="drivers/bus/mhi/core"
DEST_MODULE_LOCATION[0]="/updates/dkms/"
#STRIP[0]=no

BUILT_MODULE_NAME[1]="mhi_uci"
BUILT_MODULE_LOCATION[1]="drivers/bus/mhi"
DEST_MODULE_LOCATION[1]="/updates/dkms/"
#STRIP[1]=no

BUILT_MODULE_NAME[2]="mhi_pci"
BUILT_MODULE_LOCATION[2]="drivers/bus/mhi"
DEST_MODULE_LOCATION[2]="/updates/dkms/"
#STRIP[2]=no

BUILT_MODULE_NAME[3]="mhi_net"
BUILT_MODULE_LOCATION[3]="drivers/net/mhi"
DEST_MODULE_LOCATION[3]="/updates/dkms/"
#STRIP[3]=no

BUILT_MODULE_NAME[4]="wwan_mhi"
BUILT_MODULE_LOCATION[4]="drivers/net/wwan"
DEST_MODULE_LOCATION[4]="/updates/dkms/"
#STRIP[4]=no

BUILT_MODULE_NAME[5]="wwan"
BUILT_MODULE_LOCATION[5]="drivers/net/wwan"
DEST_MODULE_LOCATION[5]="/updates/dkms/"
#STRIP[5]=no

BUILT_MODULE_NAME[6]="mhi_ptp"
BUILT_MODULE_LOCATION[6]="drivers/ptp"
DEST_MODULE_LOCATION[6]="/updates/dkms/"
#STRIP[6]=no

AUTOINSTALL="yes"

