PACKAGE_NAME=PKG_NAME
PACKAGE_VERSION=PKG_LONG_VERSION

MAKE[0]="make MHI_MODULE_VERSION=PKG_LONG_VERSION"

BUILT_MODULE_NAME[0]=mhi
BUILT_MODULE_LOCATION[0]=mhi-host/drivers/bus/mhi/core
DEST_MODULE_LOCATION[0]=/extra
STRIP[0]=no

BUILT_MODULE_NAME[1]=mhi_uci
BUILT_MODULE_LOCATION[1]=mhi-host/drivers/bus/mhi
DEST_MODULE_LOCATION[1]=/extra
STRIP[1]=no

BUILT_MODULE_NAME[2]=mhi_pci
BUILT_MODULE_LOCATION[2]=mhi-host/drivers/bus/mhi
DEST_MODULE_LOCATION[2]=/extra
STRIP[2]=no

BUILT_MODULE_NAME[3]=mhi_net
BUILT_MODULE_LOCATION[3]=mhi-host/drivers/net/mhi
DEST_MODULE_LOCATION[3]=/extra
STRIP[3]=no

BUILT_MODULE_NAME[4]=wwan_mhi
BUILT_MODULE_LOCATION[4]=mhi-host/drivers/net/wwan
DEST_MODULE_LOCATION[4]=/extra
STRIP[4]=no

BUILT_MODULE_NAME[5]=wwan
BUILT_MODULE_LOCATION[5]=mhi-host/drivers/net/wwan
DEST_MODULE_LOCATION[5]=/extra
STRIP[5]=no

AUTOINSTALL=no
NO_WEAK_MODULES=yes
POST_BUILD="mhi-host/rpm/post-build-remove.sh $dkms_tree $kernelver build"
POST_REMOVE="mhi-host/rpm/post-build-remove.sh $dkms_tree $kernelver remove"
